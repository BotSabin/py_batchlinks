<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMBOT - Native Reconstruction from CAD"
        Width="980" Height="760" MinWidth="920" MinHeight="700"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="BlueBrush" Color="#0047B3"/>
        <SolidColorBrush x:Key="PanelBg" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D6DAE0"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0047B3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Background="#ECEFF3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Column="0" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="1. SOURCE GEOMETRY">
                    <StackPanel>
                        <TextBlock Text="Select CAD / Import / FreeForm geometry in the family." Margin="0,0,0,8"/>
                        <Button x:Name="PickButton" Content="✓ Pick Source Geometry"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/>
                                <RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Element:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ElementText" Text="Not selected"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Category:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CategoryText" Text="-"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Solids:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SolidsText" Text="-"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Faces:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FacesText" Text="-"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Cylindrical:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CylFacesText" Text="-"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Planar:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="PlanarFacesText" Text="-"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="2. RECONSTRUCTION OPTIONS">
                    <StackPanel>
                        <CheckBox x:Name="CylindersCheck" Content="Cylindrical Parts (Pipes, Bars, Round Bodies)" IsChecked="True" Margin="0,3"/>
                        <CheckBox x:Name="PlanarCheck" Content="Planar Plates / Boxes (experimental)" IsChecked="True" Margin="0,3"/>
                        <CheckBox x:Name="DeleteOriginalCheck" Content="Delete original heavy geometry after generation" IsChecked="False" Margin="0,3"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Minimum radius (mm):" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="MinRadiusBox" Text="2.0"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Minimum length (mm):" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="MinLengthBox" Text="5.0"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Grouping tolerance (mm):" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ToleranceBox" Text="6.0"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Max elements to create:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="MaxElementsBox" Text="250"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="3. MATERIALS">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Small cylinders:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="SmallMatBox" Text="BIMBOT_NATIVE_BRASS"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Large cylinders:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="LargeMatBox" Text="BIMBOT_NATIVE_STEEL"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Planar plates:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="PlateMatBox" Text="BIMBOT_NATIVE_RED"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Default:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="DefaultMatBox" Text="BIMBOT_NATIVE_GREY"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="4. ACTION">
                    <StackPanel>
                        <Button x:Name="AnalyzeButton" Content="Analyze Source Geometry"/>
                        <Button x:Name="GenerateButton" Content="▶ GENERATE NATIVE GEOMETRY" FontWeight="Bold" Background="#0A66C2" Foreground="White" Height="38"/>
                        <Button x:Name="CloseButton" Content="Close"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1" Grid.Row="0" Margin="0,8,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="210"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="RECONSTRUCTION REPORT">
                <TextBox x:Name="ReportBox" Text="Ready. Pick source geometry first." AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Background="White"/>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="DETAILS / LIMITATIONS">
                <TextBox IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="White" Text="This MVP does real Revit-native reconstruction from readable CAD solids. It detects cylindrical faces and rebuilds them as native Revit family extrusions. Planar plate/box detection is experimental. It will not be perfectly identical in version 1, but it is the correct foundation for building a full CAD reverse-engineering tool.&#x0a;&#x0a;Recommended workflow:&#x0a;1. Run Analyze.&#x0a;2. Generate with Keep Original.&#x0a;3. Compare the result in 3D.&#x0a;4. Adjust tolerance / min radius / min length.&#x0a;5. When acceptable, run again on a copy and delete original.&#x0a;&#x0a;For truly identical native Revit output, the tool needs more modules: conical/revolved face reconstruction, elbow sweep recognition, material/layer clustering, planar body clustering, and gauge/valve-specific rules."/>
            </GroupBox>
        </Grid>

        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" x:Name="StatusText" Text="Status: Ready" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold" Foreground="#008000"/>
    </Grid>
</Window>
