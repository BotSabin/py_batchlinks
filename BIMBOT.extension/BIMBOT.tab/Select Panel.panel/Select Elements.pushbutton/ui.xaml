<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Select All Like"
    Height="720"
    Width="980"
    WindowStartupLocation="CenterScreen">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Background="#263238">
            <TextBlock Text="Select All Like"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="12,10,12,2"/>

            <TextBlock Text="Search, choose level, check filters. Elements are selected automatically from the whole project."
                       Foreground="White"
                       FontSize="12"
                       Margin="12,0,12,10"/>
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtSearch"
                     Grid.Column="0"
                     Height="28"
                     Margin="0,0,10,0"/>

            <ComboBox x:Name="cmbLevel"
                      Grid.Column="1"
                      Height="28"
                      Margin="0,0,10,0"/>

            <TextBlock x:Name="txtCount"
                       Grid.Column="2"
                       Text="Count: 0"
                       FontSize="15"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid DockPanel.Dock="Bottom" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Selections are remembered per level."
                       VerticalAlignment="Center"/>

            <Button x:Name="btnSave"
                    Grid.Column="1"
                    Content="Save in Revit"
                    Height="30"
                    Margin="5,0"/>

            <Button x:Name="btnClear"
                    Grid.Column="2"
                    Content="Clear Checked"
                    Height="30"
                    Margin="5,0"/>

            <Button x:Name="btnExit"
                    Grid.Column="3"
                    Content="Exit"
                    Height="30"
                    Margin="5,0"/>
        </Grid>

        <TabControl x:Name="tabOptions"
                    Margin="10"/>
    </DockPanel>
</Window>