<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BIMBOT - Route Select"
    Width="430"
    Height="470"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="#1E1E2E">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock
                Text="BIMBOT Route Select"
                FontSize="22"
                FontWeight="Bold"
                Foreground="#CDD6F4"/>

            <TextBlock
                Text="Select MEP route using connectors"
                FontSize="12"
                Foreground="#A6ADC8"
                Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#313244"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,14">

            <StackPanel>
                <TextBlock
                    Text="Selection Mode"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#CDD6F4"
                    Margin="0,0,0,10"/>

                <RadioButton
                    x:Name="RbTwoPoints"
                    Content="2 Points Route"
                    IsChecked="True"
                    Foreground="#CDD6F4"
                    FontSize="13"
                    Margin="0,4,0,8"/>

                <RadioButton
                    x:Name="RbMultiSegment"
                    Content="Multi Segment Route"
                    Foreground="#CDD6F4"
                    FontSize="13"
                    Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="#313244"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,14">

            <StackPanel>
                <TextBlock
                    Text="Options"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#CDD6F4"
                    Margin="0,0,0,10"/>

                <CheckBox
                    x:Name="CbSameSystem"
                    Content="Same System Only"
                    IsChecked="False"
                    Foreground="#CDD6F4"
                    FontSize="13"
                    Margin="0,4,0,6"/>

                <CheckBox
                    x:Name="CbIncludeAccessories"
                    Content="Include Pipe Accessories"
                    IsChecked="True"
                    Foreground="#CDD6F4"
                    FontSize="13"
                    Margin="0,4,0,6"/>

                <CheckBox
                    x:Name="CbIncludeSprinklers"
                    Content="Include Sprinklers"
                    IsChecked="True"
                    Foreground="#CDD6F4"
                    FontSize="13"
                    Margin="0,4,0,6"/>

                <CheckBox
                    x:Name="CbIncludeFlexPipes"
                    Content="Include Flex Pipes"
                    IsChecked="True"
                    Foreground="#CDD6F4"
                    FontSize="13"
                    Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="#181825"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,14">

            <TextBlock
                x:Name="TxtInfo"
                Text="2 Points: pick Start and End.&#x0a;Multi Segment: pick Start, waypoints, then End."
                TextWrapping="Wrap"
                FontSize="12"
                Foreground="#A6ADC8"/>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button
                x:Name="BtnCancel"
                Content="Cancel"
                Width="100"
                Height="34"
                Margin="0,0,10,0"
                Background="#45475A"
                Foreground="#CDD6F4"
                BorderThickness="0"/>

            <Button
                x:Name="BtnStart"
                Content="START"
                Width="130"
                Height="34"
                Background="#89B4FA"
                Foreground="#11111B"
                FontWeight="Bold"
                BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>